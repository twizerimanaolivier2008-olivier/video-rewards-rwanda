PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=video_rewards_rwanda
# Production only: require TLS and use a dedicated non-root database user
DB_SSL=false
DB_SSL_CA=
DB_CONNECTION_LIMIT=10

# JWT
# Generate at least 32 random bytes for every environment; never reuse or commit a real secret
JWT_SECRET=replace_with_at_least_32_random_bytes

# MTN MoMo API
MOMO_API_KEY=your_momo_api_key
MOMO_API_SECRET=your_momo_api_secret
MOMO_SUBSCRIPTION_KEY=your_momo_subscription_key
MOMO_TARGET_ENVIRONMENT=sandbox

# Airtel Money API
AIRTEL_API_KEY=your_airtel_api_key
AIRTEL_API_SECRET=your_airtel_api_secret
AIRTEL_TARGET_ENVIRONMENT=sandbox

# Frontend URL
FRONTEND_URL=http://localhost:3000
# Comma-separated additional exact browser origins, if required
CORS_ALLOWED_ORIGINS=
# Set true only when the API is behind exactly one trusted reverse proxy
TRUST_PROXY=false

# SMTP email delivery (keep real credentials in backend/.env only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Initial administrator account (configure only in the ignored backend/.env)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin
