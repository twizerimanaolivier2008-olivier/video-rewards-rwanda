{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "video-rewards-rwanda",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
